{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "outDir": "./out",
    "baseUrl": ".",
    "paths": {
      "@renderer/*": ["src/renderer/src/*"],
      "@shared/*": ["shared/*"]
    }
  },
  "include": [
    "src/renderer/src/**/*",
    "shared/**/*",
    // The engine's own catalogue, used as a fixture so stories draw real modules with no engine
    // running. A test already checks this file against what a live `--catalog` prints.
    "engine/tests/golden/catalog.json"
  ]
}
