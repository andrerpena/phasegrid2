{
  "name": "phasegrid2",
  "version": "0.1.0",
  "description": "Generative grid-based modular music platform",
  "author": "Andre Pena",
  "license": "AGPL-3.0-only",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "postinstall": "node scripts/build-native.mjs",
    "dev": "node scripts/dev.mjs",
    "build": "npm run typecheck && electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "biome check . && npm run lint:trademark",
    "lint:trademark": "node scripts/check-trademark.mjs",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "vitest run --project unit",
    "engine:build": "node scripts/build-native.mjs --tests",
    "engine:test": "node scripts/build-native.mjs --tests && ctest --test-dir build --output-on-failure",
    "engine:render": "./build/engine/phasegrid-engine --render",
    "storybook": "storybook dev -p 6006 --no-open",
    "storybook:build": "storybook build"
  },
  "dependencies": {
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-slot": "^1.3.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@tanstack/react-form": "^1.33.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.43.0",
    "monaco-editor": "^0.56.0",
    "node-addon-api": "^8.9.2",
    "node-api-headers": "^1.9.0",
    "pixi.js": "^8.20.1",
    "postcss": "^8.5.28",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "zod": "^3.25.76",
    "zod-to-json-schema": "^3.25.2",
    "zustand": "^5.0.10"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.13",
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/addon-themes": "^10.6.0",
    "@storybook/react-vite": "^10.6.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^41.1.0",
    "electron-vite": "^5.0.0",
    "storybook": "^10.6.0",
    "typescript": "^5.8.2",
    "vite": "^6.2.3",
    "vitest": "^3.2.0"
  }
}
