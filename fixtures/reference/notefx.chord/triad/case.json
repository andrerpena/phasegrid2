        "from": {
          "module": "pat",
          "port": "notes"
        },
        "to": {
          "module": "chord",
          "port": "notes"
        }
      },
      {
        "id": "e1b",
        "from": {
          "module": "chord",
          "port": "notes"
        },
        "to": {
          "module": "poly",
          "port": "notes"
        }
      }
    ]
  },
  "tempo": 80,
  "bars": 2,
